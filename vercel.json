{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "pnpm run build:vercel",
      "outputDirectory": "public",
      "functions": {
        "api/[...path].ts": {
          "maxDuration": 60
        }
      },
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        },
        {
          "source": "/contacts",
          "destination": "/index.html"
        },
        {
          "source": "/track/:code",
          "destination": "/index.html"
        }
      ]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite",
      "installCommand": "node scripts/vercel-install.cjs",
      "buildCommand": "PORT=5173 BASE_PATH=/mockup/ npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/daily",
      "schedule": "0 12 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
