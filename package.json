{
  "name": "safe-walk",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev:web": "node scripts/dev-web.cjs",
    "dev:server": "node scripts/dev-api.cjs",
    "start:server": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "tsx --test server/tests/*.test.ts",
    "build": "npm run export:web",
    "start": "npm run start:server"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-leaflet": "^5.0.0",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "^1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
