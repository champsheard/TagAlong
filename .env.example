# Native app's HTTPS API/web origin, without /api. Web uses its own origin.
EXPO_PUBLIC_API_URL=

# Server-only key for api.heigit.org. Never use an EXPO_PUBLIC_ prefix.
HeiGET=
# Backward-compatible fallback for existing OpenRouteService setups.
ORS_API_KEY=
# Server-only routing fallback; activate a key at graphhopper.com.
GRAPHHOPPER_API_KEY=

# Local API workflow uses 3001; npm start otherwise defaults to 5000.
PORT=3001
DATABASE_PATH=data/safe-walk.sqlite

# Optional: identify your app to Nominatim with a URL/contact.
APP_USER_AGENT=Tagalong/1.0 (trip-planner)

# Vercel serverless deployment
FIREBASE_SERVICE_ACCOUNT_JSON=
SESSION_SECRET=
CRON_SECRET=
RESEND_API_KEY=
VERIFICATION_EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
