{
  "expo": {
    "name": "Safe Walk",
    "slug": "safe-walk",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safewalk",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Safe Walk uses your location only while a walking trip is active."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
