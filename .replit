modules = ["nodejs-22", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["glib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Tagalong Web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Tagalong API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Expo Go"

[[workflows.workflow]]
name = "Tagalong Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Tagalong API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 npm run dev:server"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Expo Go"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "EXPO_PUBLIC_API_URL=\"https://$REPLIT_DEV_DOMAIN\" npm run dev:expo"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3000

[[ports]]
localPort = 8083
externalPort = 4200

[[ports]]
localPort = 23636
externalPort = 3003

[userenv]

[userenv.development]
EXPO_PUBLIC_API_URL = "https://0396a918-f035-4d19-81da-fa013554d0c7-00-399qp7giai5fw.worf.replit.dev"

[userenv.shared]
VERIFICATION_EMAIL_FROM = "no-reply@updates.zymono.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
