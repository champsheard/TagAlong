modules = ["nodejs-22"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Safe Walk Web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Safe Walk API"

[[workflows.workflow]]
name = "Safe Walk Web"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:web"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Safe Walk API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 npm run dev:server"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[userenv]

[userenv.development]
EXPO_PUBLIC_API_URL = "https://0396a918-f035-4d19-81da-fa013554d0c7-00-399qp7giai5fw.worf.replit.dev"

[userenv.shared]
VERIFICATION_EMAIL_FROM = "no-reply@updates.zymono.com"
